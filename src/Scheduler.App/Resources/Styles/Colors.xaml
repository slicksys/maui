<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand -->
    <Color x:Key="Primary">#6366F1</Color>
    <Color x:Key="PrimaryDark">#4F46E5</Color>
    <Color x:Key="PrimaryLight">#A5B4FC</Color>
    <Color x:Key="PrimarySoft">#EEF0FF</Color>
    <Color x:Key="PrimarySoftDark">#242A4D</Color>
    <Color x:Key="Violet">#8B5CF6</Color>
    <Color x:Key="Pink">#EC4899</Color>
    <Color x:Key="Teal">#14B8A6</Color>
    <Color x:Key="Coral">#FB7185</Color>
    <Color x:Key="Amber">#F59E0B</Color>
    <Color x:Key="Emerald">#10B981</Color>
    <Color x:Key="Sky">#0EA5E9</Color>

    <!-- Light surfaces -->
    <Color x:Key="BackgroundLight">#F4F5FB</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceAltLight">#EEF0F8</Color>
    <Color x:Key="BorderLight">#E3E6F0</Color>
    <Color x:Key="TextLight">#0F172A</Color>
    <Color x:Key="TextMutedLight">#64748B</Color>

    <!-- Dark surfaces -->
    <Color x:Key="BackgroundDark">#0B0F1E</Color>
    <Color x:Key="SurfaceDark">#161B2E</Color>
    <Color x:Key="SurfaceAltDark">#1F2540</Color>
    <Color x:Key="BorderDark">#2A3150</Color>
    <Color x:Key="TextDark">#F1F5F9</Color>
    <Color x:Key="TextMutedDark">#94A3B8</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="WhiteSoft">#33FFFFFF</Color>
    <Color x:Key="WhiteGlass">#26FFFFFF</Color>

    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0.0" />
        <GradientStop Color="#8B5CF6" Offset="0.55" />
        <GradientStop Color="#EC4899" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AvatarGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#14B8A6" Offset="0.0" />
        <GradientStop Color="#6366F1" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="PinkBrush" Color="{StaticResource Pink}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
</ResourceDictionary>
