<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:Scheduler.App.ViewModels"
             xmlns:dto="clr-namespace:Scheduler.Shared.Dtos;assembly=Scheduler.Shared"
             xmlns:conv="clr-namespace:Scheduler.App.Converters"
             xmlns:h="clr-namespace:Scheduler.App.Helpers"
             x:Class="Scheduler.App.Views.ClientsPage"
             x:DataType="vm:ClientsViewModel"
             Shell.NavBarIsVisible="False"
             Title="Clients">

    <ContentPage.Resources>
        <conv:InitialsConverter x:Key="Initials" />
        <toolkit:IsNotNullConverter x:Key="IsNotNull" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <Border Grid.Row="0" Background="{StaticResource HeroGradient}" StrokeThickness="0" StrokeShape="RoundRectangle 0,0,28,28" Padding="20,18,20,20">
            <VerticalStackLayout Spacing="14">
                <Label Text="Clients" Style="{StaticResource HeroText}" FontFamily="OpenSansSemibold" FontSize="24" />
                <Border BackgroundColor="{StaticResource WhiteGlass}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Style="{StaticResource Icon}" Text="{x:Static h:Icons.Search}" TextColor="{StaticResource White}" />
                        <Entry Grid.Column="1" Text="{Binding Search}" Placeholder="Search name, phone or email" TextColor="{StaticResource White}" PlaceholderColor="#B3FFFFFF" ClearButtonVisibility="WhileEditing" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Banner}" IsVisible="{Binding HasError}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Label Style="{StaticResource Icon}" Text="{x:Static h:Icons.Error}" TextColor="{StaticResource White}" />
                <Label Grid.Column="1" Text="{Binding ErrorMessage}" TextColor="{StaticResource White}" FontSize="13" VerticalOptions="Center" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Text="{x:Static h:Icons.Cancel}" TextColor="{StaticResource White}" Command="{Binding DismissErrorCommand}" WidthRequest="36" HeightRequest="36" />
            </Grid>
        </Border>

        <RefreshView Grid.Row="2" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Clients}" SelectionMode="None" Margin="16,12,16,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.Footer>
                    <BoxView HeightRequest="90" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8" Padding="24,60" HorizontalOptions="Center">
                        <Label Style="{StaticResource Icon}" Text="{x:Static h:Icons.People}" FontSize="56" HorizontalTextAlignment="Center" TextColor="{StaticResource PrimaryLight}" />
                        <Label Text="No clients yet" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                        <Label Text="Add a client with a mobile number to start booking." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:ClientDto">
                        <Border Style="{StaticResource Card}" Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ClientsViewModel}}, Path=OpenCommand, x:DataType=vm:ClientsViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border WidthRequest="46" HeightRequest="46" StrokeThickness="0" StrokeShape="RoundRectangle 23" Background="{StaticResource AvatarGradient}">
                                    <Label Text="{Binding FullName, Converter={StaticResource Initials}}" TextColor="{StaticResource White}" FontFamily="OpenSansSemibold" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding FullName}" Style="{StaticResource CardTitle}" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Style="{StaticResource Icon}" Text="{x:Static h:Icons.Phone}" FontSize="14" />
                                        <Label Text="{Binding PhoneNumber}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Email}" Style="{StaticResource Muted}" FontSize="12" IsVisible="{Binding Email, Converter={StaticResource IsNotNull}}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Text="Book" Padding="14,6" MinimumHeightRequest="38" VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ClientsViewModel}}, Path=BookCommand, x:DataType=vm:ClientsViewModel}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="0" Grid.RowSpan="3" Style="{StaticResource Fab}" Text="{x:Static h:Icons.Add}" Command="{Binding AddCommand}" SemanticProperties.Description="New client" />
    </Grid>
</ContentPage>
